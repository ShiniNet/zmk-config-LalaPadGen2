#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    bindings = <&sticky_mod>, <&kp>;
};

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };

        sticky_mod: sticky_mod {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_wait_time 400>,
                <&none>,
                <&macro_wait_time 0>,
                <&macro_param_1to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER>;

            label = "STICKY_MOD";
        };

        tap_key: tap_key {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TAP_KEY";
        };

        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER &macro_param_2to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER &macro_param_1to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>;
        };

        tp_msc_down_right: tp_msc_down_right {
            compatible = "zmk,behavior-tap-dance";
            label = "TP_MSC_DOWN_RIGHT";
            #binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_RIGHT>;

            tapping-term-ms = <300>;
        };

        tp_msc_up_left: tp_msc_up_left {
            compatible = "zmk,behavior-tap-dance";
            label = "TP_MSC_UP_LEFT";
            #binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_LEFT>;

            tapping-term-ms = <300>;
        };

        tp_mkp_mb4_mb5: tp_mkp_mb4_mb5 {
            compatible = "zmk,behavior-tap-dance";
            label = "TP_MKP_MB4_MB5";
            #binding-cells = <0>;
            bindings = <&mkp MB4>, <&mkp MB5>;

            tapping-term-ms = <300>;
        };

        mt_tap: mt_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_TAP";
            bindings = <&tap_key>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        COMBO_TAB_ALT {
            bindings = <&lm 3 LEFT_ALT>;
            key-positions = <2 33>;
            slow-release;
            timeout-ms = <300>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&mt_tap ESCAPE Q  &mt LGUI W      &kp E               &mt_tap INT4 R  &kp T                            &kp Y     &kp U     &kp I        &kp O       &kp P
&mt LCTRL A       &mt LEFT_ALT S  &kp D               &mt_tap INT5 F  &kp G                            &kp H     &kp J     &kp K        &kp L       &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X           &mt_tap CAPSLOCK C  &kp V           &kp B                            &kp N     &kp M     &kp COMMA    &kp PERIOD  &kp SLASH
&kp ESCAPE        &none           &mo 3               &mo 2           &lt 1 SPACE  &mkp MB1  &mkp MB1  &none     &none     &none        &none       &none
                  &none           &kp RIGHT           &kp DOWN        &kp LEFT     &kp UP    &kp UP    &kp LEFT  &kp DOWN  &kp RIGHT    &none
&mkp LCLK         &mkp RCLK       &mkp MCLK                                                                                &mkp LCLK    &mkp RCLK   &mkp MCLK
&mkp MB4          &mkp MB5        &kp LG(TAB)         &kp LG(D)       &kp LCTRL                        &mkp MB4  &mkp MB5  &kp LG(TAB)  &kp LG(D)   &kp LCTRL
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp SLASH            &mt LWIN BACKSLASH  &kp MINUS            &kp SINGLE_QUOTE      &kp EQUAL                             &kp F1            &kp F2             &kp F3            &kp F4             &kp F5
&mt LEFT_CONTROL N1  &mt LALT N2         &mt LEFT_BRACKET N3  &mt RIGHT_BRACKET N4  &mt_tap F5 N5                         &kp F6            &kp F7             &kp F8            &kp F9             &kp F10
&mt LSHIFT N6        &mt_tap COMMA N7    &mt_tap DOT N8       &mt_tap SEMI N9       &mt_tap BACKSLASH N0                  &kp F11           &kp F12            &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
&trans               &trans              &trans               &trans                &trans                &trans  &trans  &trans            &trans             &trans            &trans             &trans
                     &trans              &trans               &trans                &trans                &trans  &trans  &trans            &trans             &trans            &trans
&trans               &trans              &trans                                                                                                                &trans            &trans             &trans
&kp LC(LG(LEFT))     &kp LC(LG(RIGHT))   &trans               &trans                &trans                                &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans            &trans             &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&mt_tap PRINTSCREEN ESCAPE  &mt LWIN PERIOD  &tp_msc_up_left     &tp_mkp_mb4_mb5  &kp TAB                   &mt_tap END HOME  &kp UP_ARROW   &kp TAB    &kp RWIN             &kp ESCAPE
&mt LCTRL MINUS             &mt LALT ENTER   &tp_msc_down_right  &mkp MB1         &mkp MB3                  &kp LEFT_ARROW    &kp DOWN       &kp RIGHT  &mt ENTER RIGHT_ALT  &kp RIGHT_CONTROL
&mt LSHIFT INSERT           &kp BACKSPACE    &kp SPACE           &mkp MB2         &kp DEL                   &kp PAGE_UP       &kp PAGE_DOWN  &kp SPACE  &kp BACKSPACE        &kp RSHIFT
&trans                      &trans           &trans              &trans           &trans    &trans  &trans  &trans            &trans         &trans     &trans               &trans
                            &trans           &trans              &trans           &trans    &trans  &trans  &trans            &trans         &trans     &trans
&trans                      &trans           &trans                                                                                          &trans     &trans               &trans
&trans                      &trans           &trans              &trans           &trans                    &trans            &trans         &trans     &trans               &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp K_MUTE                    &mt C_BRIGHTNESS_DEC C_BRIGHTNESS_INC  &kp TAB         &kp UP_ARROW    &mt END HOME                     &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&mt LEFT_CONTROL C_VOLUME_UP  &mt LEFT_ALT ENTER                     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW                  &sys_reset                     &mkp MB1                       &bt BT_CLR                     &bt BT_CLR_ALL                 &bootloader
&mt LEFT_SHIFT C_VOLUME_DOWN  &kp LG(BACKSPACE)                      &kp SPACE       &kp PAGE_DOWN   &kp PAGE_UP                      &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans                        &trans                                 &trans          &trans          &trans           &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
                              &trans                                 &trans          &trans          &trans           &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans                        &trans                                 &trans                                                                                                                         &trans                         &trans                         &trans
&trans                        &trans                                 &trans          &trans          &trans                           &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
