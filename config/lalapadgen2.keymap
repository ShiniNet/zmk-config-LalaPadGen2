#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

// Mac / iPad layers. MAC_DEFAULT is turned on automatically while BT_SEL 1 (Mac)
// or BT_SEL 2 (iPad) is selected (src/os_layer.c, LALAPAD_OS_LAYER_* in Kconfig).
// If you renumber, also update lowspeedmode layers in lalapadgen2.dtsi and
// CONFIG_LALAPAD_OS_LAYER_MAC_LAYER.
#define MAC_DEFAULT_LAYER   4
#define MAC_SECONDARY_LAYER 5
#define MAC_TERTIARY_LAYER  6
#define MAC_SYSTEM_LAYER    7

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        BackSpace {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <18 19>;
        };

        Grave {
            bindings = <&kp GRAVE>;
            key-positions = <10 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q              &kp W           &kp E         &kp R      &kp T                               &kp Y      &kp U     &kp I          &kp O           &mt2 BACKSPACE P
&kp A              &kp S           &kp D         &kp F      &kp G                               &kp H      &kp J     &kp K          &kp L           &mt2 ENTER SEMICOLON
&mt2 LEFT_SHIFT Z  &kp X           &kp C         &kp V      &kp B                               &kp N      &kp M     &kp COMMA      &kp PERIOD      &mt RIGHT_SHIFT SLASH
&kp LCTRL          &kp LWIN        &kp LEFT_ALT  &mo 2      &kp SPACE  &mkp MB1  &kp BACKSPACE  &kp ENTER  &mo 1     &kp BACKSLASH  &kp BACKSPACE   &kp ENTER
                   &kp LANGUAGE_2  &kp RIGHT     &kp DOWN   &kp LEFT   &kp UP    &kp UP         &kp LEFT   &kp DOWN  &kp RIGHT      &kp LANGUAGE_1
&mkp LCLK          &mkp RCLK       &mkp MCLK                                                                         &mkp LCLK      &mkp RCLK       &mkp MCLK
&mkp MB4           &mkp MB5        &kp LG(TAB)   &kp LG(D)  &kp LCTRL                           &mkp MB4   &mkp MB5  &kp LG(TAB)    &kp LG(D)       &kp LCTRL
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp NUMBER_6                 &kp NUMBER_7       &kp NUMBER_8    &kp NUMBER_9     &kp NUMBER_0                  &kp LS(NUMBER_6)  &kp LS(NUMBER_7)   &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(NUMBER_0)
&kp NUMBER_1                 &kp NUMBER_2       &kp NUMBER_3    &kp NUMBER_4     &kp NUMBER_5                  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)   &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)
&mt LEFT_SHIFT LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE                      &kp MINUS         &kp EQUAL          &trans            &trans            &mt RIGHT_SHIFT DOUBLE_QUOTES
&trans                       &trans             &trans          &trans           &trans        &trans  &trans  &trans            &trans             &trans            &kp KP_DOT        &kp KP_DIVIDE
                             &trans             &trans          &trans           &trans        &trans  &trans  &trans            &trans             &trans            &trans
&trans                       &trans             &trans                                                                                              &trans            &trans            &trans
&kp LC(LG(LEFT))             &kp LC(LG(RIGHT))  &trans          &trans           &trans                        &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans            &trans            &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&kp LA(GRAVE)   &kp F9  &kp F10  &kp F11  &kp F12                  &kp HOME         &kp PAGE_UP        &kp UP_ARROW    &kp PAGE_DOWN  &kp DELETE
&kp TAB         &kp F5  &kp F6   &kp F7   &kp F8                   &kp END          &kp LEFT           &kp DOWN_ARROW  &kp RIGHT      &kp APOS
&kp LEFT_SHIFT  &kp F1  &kp F2   &kp F3   &kp F4                   &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans          &kp MINUS      &kp EQUAL
&trans          &trans  &trans   &trans   &trans   &trans  &trans  &trans           &trans             &trans          &trans         &trans
                &trans  &trans   &trans   &trans   &trans  &trans  &trans           &trans             &trans          &trans
&trans          &trans  &trans                                                                         &trans          &trans         &trans
&trans          &trans  &trans   &trans   &trans                   &trans           &trans             &trans          &trans         &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &tog MAC_DEFAULT_LAYER
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&none    &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
         &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                   &trans                         &trans                         &trans
&trans   &trans   &trans   &trans   &trans                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };

        MAC_DEFAULT_LAYER {
            display-name = "mac_default";
            bindings = <
&kp Q                 &kp W                  &kp E             &kp R          &kp T                               &kp Y                 &kp U                  &kp I             &kp O           &mt2 BACKSPACE P
&kp A                 &kp S                  &kp D             &kp F          &kp G                               &kp H                 &kp J                  &kp K             &kp L           &mt2 ENTER SEMICOLON
&mt2 LEFT_SHIFT Z     &kp X                  &kp C             &kp V          &kp B                               &kp N                 &kp M                  &kp COMMA         &kp PERIOD      &mt RIGHT_SHIFT SLASH
&kp LGUI              &kp LCTRL              &kp LEFT_ALT      &mo MAC_TERTIARY_LAYER  &kp SPACE  &mkp MB1  &kp BACKSPACE  &kp ENTER  &mo MAC_SECONDARY_LAYER  &kp BACKSLASH     &kp LANGUAGE_2  &kp LANGUAGE_1
                      &kp LANGUAGE_2         &kp RIGHT         &kp DOWN       &kp LEFT   &kp UP    &kp UP         &kp LEFT   &kp DOWN               &kp RIGHT         &kp LANGUAGE_1
&mkp LCLK             &mkp RCLK              &mkp MCLK                                                                                                            &mkp LCLK         &mkp RCLK       &mkp MCLK
&kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &kp LC(UP_ARROW)  &kp F11        &kp LGUI                            &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &kp LC(UP_ARROW)  &kp F11         &kp LGUI
            >;
        };

        MAC_SECONDARY_LAYER {
            display-name = "mac_secondary";
            bindings = <
&kp NUMBER_6                 &kp NUMBER_7       &kp NUMBER_8    &kp NUMBER_9     &kp NUMBER_0                  &kp LS(NUMBER_6)  &kp LS(NUMBER_7)   &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(NUMBER_0)
&kp NUMBER_1                 &kp NUMBER_2       &kp NUMBER_3    &kp NUMBER_4     &kp NUMBER_5                  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)   &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)
&mt LEFT_SHIFT LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE                      &kp MINUS         &kp EQUAL          &trans            &trans            &mt RIGHT_SHIFT DOUBLE_QUOTES
&trans                       &trans             &trans          &trans           &trans        &trans  &trans  &trans            &trans             &trans            &kp KP_DOT        &kp KP_DIVIDE
                             &trans             &trans          &trans           &trans        &trans  &trans  &trans            &trans             &trans            &trans
&trans                       &trans             &trans                                                                                              &trans            &trans            &trans
&kp LC(LEFT)                 &kp LC(RIGHT)      &trans          &trans           &trans                        &kp LC(LEFT)      &kp LC(RIGHT)      &trans            &trans            &trans
            >;
        };

        MAC_TERTIARY_LAYER {
            display-name = "mac_tertiary";
            bindings = <
&kp LANGUAGE_2  &kp F9  &kp F10  &kp F11  &kp F12                  &kp LG(LEFT)       &kp PAGE_UP    &kp UP_ARROW    &kp PAGE_DOWN  &kp LANGUAGE_1
&kp TAB         &kp F5  &kp F6   &kp F7   &kp F8                   &kp LG(RIGHT)      &kp LEFT       &kp DOWN_ARROW  &kp RIGHT      &kp APOS
&kp LEFT_SHIFT  &kp F1  &kp F2   &kp F3   &kp F4                   &kp LC(LS(TAB))    &kp LC(TAB)    &kp DELETE      &kp MINUS      &kp EQUAL
&trans          &trans  &trans   &trans   &trans   &trans  &trans  &trans             &trans         &trans          &trans         &trans
                &trans  &trans   &trans   &trans   &trans  &trans  &trans             &trans         &trans          &trans
&trans          &trans  &trans                                                                       &trans          &trans         &trans
&trans          &trans  &trans   &trans   &trans                   &trans             &trans         &trans          &trans         &trans
            >;
        };

        MAC_SYSTEM_LAYER {
            display-name = "mac_system";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &tog MAC_DEFAULT_LAYER
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&none    &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
         &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                   &trans                         &trans                         &trans
&trans   &trans   &trans   &trans   &trans                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <SECONDARY_LAYER TERTIARY_LAYER>;
            then-layer = <SYSTEM_LAYER>;
        };

        Cond_Syslayer_Mac {
            if-layers = <MAC_SECONDARY_LAYER MAC_TERTIARY_LAYER>;
            then-layer = <MAC_SYSTEM_LAYER>;
        };
    };
};
