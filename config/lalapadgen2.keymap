#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&mo 3>;
        };

        swapper: swapper {
            compatible = "zmk,behavior-smart-toggle";
            #binding-cells = <0>;
            bindings = <&kp LALT>, <&kp TAB>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        NN {
            bindings = <&NN>;
            key-positions = <17 16>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <30 24>;
        };
    };

    macros {
        NN: NN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp N>;
            label = "NN";
        };

        win_H: win_H {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kt LEFT_META>,
                <&macro_wait_time 20>,
                <&kp H &kt LEFT_META>;

            label = "WIN_H";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q               &kp P      &kp U         &kp Y             &kp COMMA                                   &kp J        &kp D             &kp H          &kp G          &kp W
&mt LEFT_CONTROL I  &kp O      &kp E         &kp A             &kp PERIOD                                  &kp K        &kp T             &kp N          &kp S          &mt RIGHT_CONTROL R
&mt2 LEFT_SHIFT Z   &kp X      &kp MINUS     &kp C             &kp SLASH                                   &kp M        &kp L             &kp F          &kp B          &mt RSHIFT V
&kp LCTRL           &kp LWIN   &kp LEFT_ALT  &lt 2 LANGUAGE_2  &lt 5 SPACE  &kp LEFT_SHIFT  &kp BACKSPACE  &lt 7 ENTER  &lt 3 LANGUAGE_1  &kp RIGHT_ALT  &kp SEMICOLON  &kp BACKSLASH
                    &none      &kp RIGHT     &kp DOWN          &kp LEFT     &kp UP          &kp UP         &kp LEFT     &kp DOWN          &kp RIGHT      &none
&mkp LCLK           &mkp RCLK  &mkp MCLK                                                                                                  &mkp LCLK      &mkp RCLK      &mkp MCLK
&mkp MB4            &mkp MB5   &kp LG(TAB)   &kp LG(D)         &kp LCTRL                                   &mkp MB4     &mkp MB5          &kp LG(TAB)    &kp LG(D)      &kp LCTRL
            >;
        };

        AND_DEF {
            bindings = <
&kp Q               &kp P      &kp U         &kp Y             &kp COMMA                           &kp J      &kp D             &kp H          &kp G          &kp W
&mt LEFT_CONTROL I  &kp O      &kp E         &kp A             &kp PERIOD                          &kp K      &kp T             &kp N          &kp S          &mt RIGHT_CONTROL R
&mt2 LEFT_SHIFT Z   &kp X      &kp MINUS     &kp C             &kp SLASH                           &kp M      &kp L             &kp F          &kp B          &mt RSHIFT V
&kp LCTRL           &kp LWIN   &kp LEFT_ALT  &lt 2 LANGUAGE_2  &lt 6 SPACE  &NN     &kp BACKSPACE  &kp ENTER  &lt 3 LANGUAGE_1  &kp RIGHT_ALT  &kp SEMICOLON  &kp BACKSLASH
                    &none      &kp RIGHT     &kp DOWN          &kp LEFT     &kp UP  &kp UP         &kp LEFT   &kp DOWN          &kp RIGHT      &none
&mkp LCLK           &mkp RCLK  &mkp MCLK                                                                                        &mkp LCLK      &mkp RCLK      &mkp MCLK
&mkp MB4            &mkp MB5   &kp LG(TAB)   &kp LG(D)         &kp LCTRL                           &mkp MB4   &mkp MB5          &kp LG(TAB)    &kp LG(D)
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp COMMA         &kp N7             &kp N8        &kp N9  &kp PLUS                    &trans            &kp F7             &kp F8  &kp F9  &kp F12
&kp PERIOD        &kp N4             &kp N5        &kp N6  &kp MINUS                   &kp ASTERISK      &kp F4             &kp F5  &kp F6  &kp F11
&kp N0            &kp N1             &kp N2        &kp N3  &kp EQUAL                   &kp SLASH         &kp F1             &kp F2  &kp F3  &kp F10
&kp DEL           &kp RCTRL          &kp LEFT_ALT  &trans  &trans     &trans  &kp DEL  &trans            &trans             &trans  &trans  &trans
                  &trans             &trans        &trans  &trans     &trans  &trans   &trans            &trans             &trans  &trans
&trans            &trans             &trans                                                                                 &trans  &trans  &trans
&kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans        &trans  &trans                      &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans  &trans  &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR            &kp PERCENT                                   &kp CARET   &kp AMPERSAND  &kp ASTERISK  &kp MINUS       &kp EQUAL
&kp GRAVE        &kp TILDE     &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                         &trans      &trans         &trans        &kp UNDERSCORE  &kp PLUS
&kp GRAVE        &kp SQT       &kp SEMI      &kp LEFT_BRACKET      &kp RIGHT_BRACKET                             &kp DELETE  &trans         &trans        &trans          &kp PAUSE_BREAK
&kp RCTRL        &kp LEFT_ALT  &trans        &trans                &kp SPACE              &trans  &kp BACKSPACE  &kp LSHFT   &trans         &trans        &trans          &trans
                 &trans        &trans        &trans                &trans                 &trans  &trans         &trans      &trans         &trans        &trans
&trans           &trans        &trans                                                                                                       &trans        &trans          &trans
&trans           &trans        &trans        &trans                &trans                                        &trans      &trans         &trans        &trans          &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &kp CAPSLOCK
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&to 0    &to 1    &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
         &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                   &trans                         &trans                         &trans
&trans   &trans   &trans   &trans   &trans                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };

        Shortcut {
            bindings = <
&kp LC(L)    &kp LC(T)      &kp LC(LS(TAB))  &kp LC(W)  &kp LC(R)                  &kp PG_UP  &kp HOME        &kp UP_ARROW    &kp END          &trans
&kp LG(TAB)  &kp LS(LC(T))  &kp LC(TAB)      &trans     &kp LC(F)                  &kp PG_DN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp SLCK
&kp LG(D)    &trans         &trans           &trans     &kp SPACE                  &trans     &mkp MB4        &trans          &mkp MB5         &trans
&trans       &trans         &trans           &trans     &trans     &trans  &trans  &trans     &trans          &trans          &trans           &trans
             &trans         &trans           &trans     &trans     &trans  &trans  &trans     &trans          &trans          &trans
&trans       &trans         &trans                                                                            &trans          &trans           &trans
&trans       &trans         &trans           &trans     &trans                     &trans     &trans          &trans          &trans           &trans
            >;
        };

        shortcat_and {
            bindings = <
&kp LC(L)    &kp LC(T)  &kp LS(LC(TAB))  &kp LC(W)  &kp LC(R)                          &trans  &trans  &trans  &trans  &trans
&kp LG(TAB)  &kp TAB    &kp LC(TAB)      &mkp LCLK  &kp LC(F)                          &trans  &trans  &trans  &trans  &trans
&win_H       &trans     &trans           &trans     &kp LG(BACKSPACE)                  &trans  &trans  &trans  &trans  &trans
&trans       &trans     &trans           &trans     &trans             &trans  &trans  &trans  &trans  &trans  &trans  &trans
             &trans     &trans           &trans     &trans             &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans     &trans                                                                         &trans  &trans  &trans
&trans       &trans     &trans           &trans     &trans                             &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &mkp MB4         &mkp MB5     &kp LC(T)  &swapper  &trans
&trans  &trans  &trans  &trans  &trans                  &kp LC(LS(TAB))  &kp LC(TAB)  &kp LC(W)  &trans   &trans
&trans  &trans  &trans  &trans  &trans                  &trans           &trans       &trans     &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans           &trans       &trans     &trans   &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans           &trans       &trans     &trans
&trans  &trans  &trans                                                                &trans     &trans   &trans
&trans  &trans  &trans  &trans  &trans                  &trans           &trans       &trans     &trans   &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};
