#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define NUMBER_LAYER    1
#define ARROW_LAYER     2
#define SYSTEM_LAYER    3
#define SYMBOL_LAYER    4

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        English {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <13 12>;
        };

        Japanese {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <16 17>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q              &kp W         &kp E              &kp R                   &kp T                                      &kp Y            &kp U        &kp I        &kp O       &kp P
&kp A              &kp S         &kp D              &kp F                   &kp G                                      &kp H            &kp J        &kp K        &kp L       &mt2 EQUAL MINUS
&mt2 LEFT_SHIFT Z  &kp X         &kp C              &kp V                   &kp B                                      &kp N            &kp M        &kp COMMA    &kp PERIOD  &mt RIGHT_SHIFT SLASH
&kp LEFT_GUI       &kp LEFT_ALT  &lt 3 PRINTSCREEN  &mt LEFT_CONTROL SPACE  &lt 4 TAB  &kp LANGUAGE_2  &kp LANGUAGE_1  &lt 1 BACKSPACE  &lt 2 ENTER  &kp ESCAPE   &kp DELETE  &kp BACKSLASH
                   &none         &kp RIGHT          &kp DOWN                &kp LEFT   &kp UP          &kp UP          &kp LEFT         &kp DOWN     &kp RIGHT    &none
&mkp LCLK          &mkp RCLK     &mkp MCLK                                                                                                           &mkp LCLK    &mkp RCLK   &mkp MCLK
&mkp MB5           &mkp MB4      &kp LG(TAB)        &kp LG(D)               &kp LCTRL                                  &mkp MB5         &mkp MB4     &kp LG(TAB)  &kp LG(D)   &kp LCTRL
            >;
        };

        NUMBER_LAYER {
            display-name = "number_layer";
            bindings = <
&kp F12           &kp F7             &kp F8  &kp F9  &none                   &none             &kp NUMBER_7       &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS
&kp F11           &kp F4             &kp F5  &kp F6  &none                   &none             &kp NUMBER_4       &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS
&kp F10           &kp F1             &kp F2  &kp F3  &none                   &kp NUMBER_0      &kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3  &kp KP_ASTERISK
&trans            &trans             &trans  &trans  &trans  &trans  &trans  &trans            &trans             &kp COMMA     &kp PERIOD    &kp KP_DIVIDE
                  &trans             &trans  &trans  &trans  &trans  &trans  &trans            &trans             &trans        &trans
&trans            &trans             &trans                                                                       &trans        &trans        &trans
&kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans  &trans  &trans                  &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans        &trans        &trans
            >;
        };

        ARROW_LAYER {
            display-name = "arrow_layer";
            bindings = <
&none   &none   &none   &none   &none                   &kp PAGE_UP    &kp HOME  &kp UP_ARROW    &kp END    &none
&none   &none   &none   &none   &none                   &kp PAGE_DOWN  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &none
&none   &none   &none   &none   &none                   &none          &mkp MB4  &none           &mkp MB5   &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans    &trans          &trans     &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans    &trans          &trans
&trans  &trans  &trans                                                           &trans          &trans     &trans
&trans  &trans  &trans  &trans  &trans                  &trans         &trans    &trans          &trans     &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&none   &none   &none   &none   &none                   &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&none   &none   &none   &none   &none                   &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &none
&none   &none   &none   &none   &none                   &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans  &trans  &trans                                                                                                &trans                         &trans                         &trans
&trans  &trans  &trans  &trans  &trans                  &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };

        SYMBOL_LAYER {
            bindings = <
&none   &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &none                   &kp GRAVE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SQT               &kp DOUBLE_QUOTES
&none   &kp DOLLAR       &kp PERCENT   &kp LCTRL             &none                   &kp TILDE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON         &kp COLON
&none   &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &none                   &kp PIPE   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp NON_US_BACKSLASH  &kp UNDERSCORE
&trans  &trans           &trans        &trans                &trans  &trans  &trans  &trans     &trans                &trans                 &trans                &trans
        &trans           &trans        &trans                &trans  &trans  &trans  &trans     &trans                &trans                 &trans
&trans  &trans           &trans                                                                                       &trans                 &trans                &trans
&trans  &trans           &trans        &trans                &trans                  &trans     &trans                &trans                 &trans                &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
