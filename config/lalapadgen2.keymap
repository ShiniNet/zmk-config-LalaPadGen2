#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };

        mm_2: mm_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_2";
            bindings = <&kp N2>, <&kp DQT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_6: mm_6 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_6";
            bindings = <&kp N6>, <&kp AMPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_7: mm_7 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_7";
            bindings = <&kp N7>, <&kp SQT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_8: mm_8 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_8";
            bindings = <&kp N8>, <&kp LPAR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_9: mm_9 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_9";
            bindings = <&kp N9>, <&kp RPAR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_0: mm_0 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_0";
            bindings = <&kp N0>, <&kp N0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        new_minus: new_minus {
            compatible = "zmk,behavior-mod-morph";
            label = "NEW_MINUS";
            bindings = <&kp MINUS>, <&kp EQUAL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_caret: mm_caret {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_CARET";
            bindings = <&kp CARET>, <&kp TILDE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_at: mm_at {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_AT";
            bindings = <&kp AT>, <&kp GRAVE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_semi: mm_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_SEMI";
            bindings = <&kp SEMI>, <&kp PLUS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_colon: mm_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_COLON";
            bindings = <&kp COLON>, <&kp ASTRK>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_bslh: mm_bslh {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BSLH";
            bindings = <&kp BSLH>, <&kp UNDER>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_yen: mm_yen {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_YEN";
            bindings = <&kp 0x89>, <&kp PIPE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q           &kp W          &kp E              &kp R               &kp T                                 &kp Y           &kp U          &kp I             &kp O               &kp P
&kp A           &kp S          &kp D              &kp F               &kp G                                 &kp H           &kp J          &kp K             &kp L               &mt EQUAL MINUS
&kp Z           &kp X          &kp C              &kp V               &kp B                                 &kp N           &kp M          &kp COMMA         &kp PERIOD          &kp SLASH
&kp LEFT_SHIFT  &kp LWIN       &kp LEFT_CONTROL   &kp RIGHT_ALT       &kp SPACE         &mo 1       &mo 2   &kp ENTER       &kp BACKSPACE  &kp LANGUAGE_2    &kp LANGUAGE_1      &mm_bslh
                &kp LA(LC(C))  &kp LA(LC(RIGHT))  &kp LC(DOWN)        &kp LC(LA(LEFT))  &kp LC(UP)  &kp UP  &kp LEFT_ARROW  &kp DOWN       &kp RIGHT         &trans
&mkp LCLK       &mkp RCLK      &mkp MCLK                                                                                                   &mkp LCLK         &mkp RCLK           &mkp MCLK
&mkp MB5        &mkp MB4       &kp LC(UP_ARROW)   &kp LC(DOWN_ARROW)  &kp LEFT_CONTROL                      &mkp MB5        &mkp MB4       &kp LC(UP_ARROW)  &kp LC(DOWN_ARROW)  &kp LEFT_CONTROL
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp NUMBER_1  &mm_2   &kp NUMBER_3  &kp NUMBER_4  &kp N5                  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&mm_6         &mm_7   &mm_8         &mm_9         &mm_0                   &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
&trans        &trans  &kp LBKT      &kp RBKT      &trans                  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ASTERISK
&trans        &trans  &trans        &trans        &trans  &trans  &trans  &trans  &trans           &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_DIVIDE
              &trans  &trans        &trans        &trans  &trans  &trans  &trans  &trans           &trans           &trans
&trans        &trans  &trans                                                                       &trans           &trans           &trans
&trans        &trans  &trans        &trans        &trans                  &trans  &trans           &trans           &trans           &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&kp EXCLAMATION  &kp DQT        &kp HASH                 &kp DOLLAR  &kp PERCENT                             &kp PAGE_UP    &kp HOME        &trans          &kp END          &kp PRINTSCREEN
&kp AMPS         &kp SQT        &kp LPAR                 &kp RPAR    &mm_yen                                 &kp PAGE_DOWN  &mkp MB4        &kp UP_ARROW    &mkp MB5         &kp SCROLLLOCK
&trans           &trans         &kp LBKT                 &kp RBKT    &trans                                  &trans         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAUSE_BREAK
&trans           &trans         &trans                   &trans      &trans                  &trans  &trans  &trans         &trans          &trans          &trans           &trans
                 &kp LC(LA(F))  &kp LA(LG(RIGHT_ARROW))  &trans      &kp LA(LG(LEFT_ARROW))  &trans  &trans  &trans         &trans          &trans          &trans
&trans           &trans         &trans                                                                                                      &trans          &trans           &trans
&trans           &trans         &trans                   &trans      &trans                                  &trans         &trans          &trans          &trans           &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &trans
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
         &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                   &trans                         &trans                         &trans
&trans   &trans   &trans   &trans   &trans                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
